{
  "name": "three-clouds-webgpu",
  "version": "0.1.0-alpha.7",
  "description": "Unofficial WebGPU/TSL volumetric clouds for Three.js, with explicit composition, baked assets and optional React bindings",
  "keywords": [
    "three",
    "three.js",
    "webgpu",
    "tsl",
    "geospatial",
    "volumetric",
    "clouds",
    "raymarching",
    "takram"
  ],
  "author": "John Fewell (https://github.com/johnfewell)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnfewell/three-clouds-webgpu.git"
  },
  "homepage": "https://github.com/johnfewell/three-clouds-webgpu#readme",
  "bugs": {
    "url": "https://github.com/johnfewell/three-clouds-webgpu/issues"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./webgpu": {
      "types": "./types/index.d.ts",
      "import": "./build/webgpu.js",
      "default": "./build/webgpu.js"
    },
    "./r3f": {
      "types": "./types/r3f/index.d.ts",
      "import": "./build/r3f.js",
      "default": "./build/r3f.js"
    },
    "./package.json": "./package.json",
    "./assets/*": "./assets/*"
  },
  "module": "./build/index.js",
  "types": "./types/index.d.ts",
  "files": [
    "assets",
    "build",
    "src",
    "types",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!types/**/*.test.d.ts",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTING.md",
    "INTEGRATION.md",
    "WEBGPU.md",
    "docs/API.md",
    "docs/CONSUMER_CONTRACT.md",
    "docs/MIGRATION.md",
    "docs/EXPERIMENTAL.md",
    "docs/BENCHMARKS.md",
    "docs/night-sky.md",
    "docs/adr",
    "docs/experimental/cloudTypeMap/*.webp",
    "docs/experimental/cloudTypeMap/README.md",
    "docs/experimental/cirrusDeck/*.webp",
    "docs/experimental/cirrusDeck/README.md",
    "docs/images/demo.webp",
    "recipes/*/README.md",
    "recipes/*/package.json",
    "recipes/*/pnpm-workspace.yaml",
    "recipes/*/tsconfig.json",
    "recipes/*/vite.config.ts",
    "recipes/*/index.html",
    "recipes/*/src/*.ts",
    "recipes/*/src/*.tsx",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "bench": "node examples/parity/scripts/benchmarks/run.mjs",
    "bench:prepare": "node examples/parity/scripts/benchmarks/prepare.mjs",
    "bench:compare": "node examples/parity/scripts/benchmarks/compare.mjs",
    "build:code": "node scripts/release/pack-provenance.mjs clean-types && vite build && node scripts/dts-extensions.mjs",
    "build": "pnpm build:code && node scripts/release/pack-provenance.mjs write",
    "prepack": "node scripts/release/pack-provenance.mjs check && pnpm docs:api:check",
    "pack:verify": "node scripts/release/pack-archive.mjs",
    "pack:qualify": "node scripts/release/qualify-consumer.mjs",
    "typecheck": "pnpm build && tsc --noEmit -p tsconfig.json && tsc --noEmit -p examples/parity/tsconfig.json && tsc --noEmit -p core/emit/tsconfig.json && pnpm typecheck:examples && pnpm typecheck:example-apps",
    "typecheck:examples": "node scripts/port-gates/example-diagnostics.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm docs:api:check && pnpm lint && pnpm gates && pnpm test",
    "gates": "pnpm dlx oxlint@1.80.0 -c scripts/port-gates/oxlintrc.json src && node scripts/port-gates/decision-points.mjs src --max 12 && node scripts/port-gates/comment-audit.mjs src && node scripts/port-gates/citations.mjs src",
    "e2e": "pnpm --filter parity e2e",
    "docs:api": "pnpm build:code && node scripts/docs/api-reference.mjs && node scripts/release/pack-provenance.mjs write",
    "docs:api:check": "node scripts/docs/api-reference.mjs --check",
    "docs:api:html": "pnpm dlx typedoc@0.28.20 --options typedoc.json",
    "site:build": "node scripts/release/build-site.mjs",
    "typecheck:example-apps": "tsc --noEmit -p examples/storybook/tsconfig.json && tsc --noEmit -p examples/basic/tsconfig.json && tsc --noEmit -p examples/r3f/tsconfig.json && tsc --noEmit -p examples/demo/tsconfig.json && tsc --noEmit -p examples/tiles/tsconfig.json"
  },
  "dependencies": {
    "tiny-invariant": "^1.3.3"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.0.0",
    "@takram/three-atmosphere": "^0.19.1",
    "@takram/three-geospatial": "^0.9.1",
    "react": ">=19.0.0",
    "three": ">=0.187.0 <0.188.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@react-three/fiber": "9.7.0",
    "@takram/three-atmosphere": "0.19.1",
    "@takram/three-geospatial": "0.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.0.0",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-comment-slop": "0.4.0",
    "jsdom": "^26.1.0",
    "lil-gui": "^0.20.0",
    "prettier": "^3.8.3",
    "prettier-plugin-glsl": "^0.2.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stats-gl": "^4.1.0",
    "three": "0.187.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.59.3",
    "type-fest": "^5.4.4",
    "vite": "^7.1.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@11.8.0",
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
