{
  "name": "clouds-storybook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "storybook dev --port 6006 --no-open --ci",
    "storybook": "storybook dev --port 6006",
    "build": "storybook build --output-dir dist",
    "dev:showcase": "pnpm setup-assets && STORYBOOK_SURFACE=showcase storybook dev --port 6007 --no-open --ci",
    "build:showcase": "pnpm setup-assets && STORYBOOK_SURFACE=showcase storybook build --output-dir dist && node scripts/check-showcase.mjs dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "setup-assets": "node ../../scripts/setup-assets.mjs --example examples/storybook --from three-clouds-webgpu",
    "predev": "pnpm setup-assets",
    "prestorybook": "pnpm setup-assets",
    "prebuild": "pnpm setup-assets"
  },
  "dependencies": {
    "3d-tiles-renderer": "0.4.28",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.0.4",
    "@takram/three-atmosphere": "0.19.1",
    "@takram/three-clouds": "0.7.6",
    "@takram/three-geospatial": "0.9.1",
    "@takram/three-geospatial-effects": "0.6.4",
    "jotai": "^2.20.0",
    "leva": "^0.10.1",
    "motion": "^12.38.0",
    "postprocessing": "6.39.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-merge-refs": "^3.0.2",
    "react-use": "^17.6.0",
    "shallowequal": "^1.1.0",
    "stats-gl": "^4.1.0",
    "three": "0.187.0",
    "three-clouds-webgpu": "workspace:*",
    "tiny-invariant": "^1.3.3",
    "workerpool": "^10.0.2"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/shallowequal": "^1.1.5",
    "@types/three": "0.187.0",
    "@webgpu/types": "^0.1.72",
    "storybook": "10.6.0",
    "typescript": "5.9.2",
    "vite": "^7.1.5"
  }
}
